{
  "id": "./",
  "name": "QR Studio",
  "short_name": "QR Studio",
  "description": "Private browser-based QR generator, designer, scanner, batch studio and local QR library.",
  "start_url": "./index.html#generator",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f6f8fc",
